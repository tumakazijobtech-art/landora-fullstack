# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Database Access user, not your Atlas login)
MONGO_URI=...

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=...

# How long login tokens stay valid
JWT_EXPIRES_IN=7d

# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your deployed frontend URL)
CORS_ORIGINS=http://localhost:5173, https://landora-frontend.vercel.app/

# Optional delivery webhooks. Each receives { channel, destination, code, purpose, brand }.
# Set these before enabling verification in production.
EMAIL_WEBHOOK_URL=
# Also powers general SMS notifications for key actions (new application, lease
# accepted/declined, ID verified, phone verified, new chat message when the
# recipient isn't online) — see backend/services/sms.js. Without it set, those
# notifications are just skipped with a console warning; nothing in the app's
# workflow depends on them being delivered.
SMS_WEBHOOK_URL=
# Useful for local QA only; never enable this in a public production environment.
DEV_RETURN_VERIFICATION_CODES=false

# Optional national ID (IPRS-style) verification webhook for buyers (farmers) and
# sellers (landowners) — see backend/services/idVerification.js. POSTed
# { idNumber, fullName, brand }, expected to respond { matched, fullNameOnRecord?,
# reason? }. Without this set, ID submissions are simply queued as "pending" for an
# admin to verify manually from /admin -> Users, the same fallback
# Parcel.titleVerification already uses for a land title not yet reachable on
# Ardhisasa. Nothing breaks (registration/sign-in/browsing all still work) — only
# applying to lease and publishing a listing require a verified ID, see
# requireIdVerified in backend/middleware/auth.js.
IPRS_WEBHOOK_URL=

# Inbox that "Join the waitlist" and parcel pre booking submissions notify. Delivery
# uses EMAIL_WEBHOOK_URL above (it receives { to, subject, text, brand }); without a
# webhook configured, submissions still save and appear on the admin console, they
# just aren't emailed.
ADMIN_EMAIL=

# --- M-Pesa (Daraja) — powers every "Pay with M-Pesa" prompt: lease commission,
# land verification, digital lease contracts, and subscriptions. See
# backend/services/mpesa.js for how these are used. Get consumer key/secret and the
# passkey from https://developer.safaricom.co.ke (sandbox) or your Daraja production
# app. The till number / shortcode used on each STK push (PartyB/BusinessShortCode)
# is NOT set here — it is admin-editable at runtime under Admin -> Fees & Payments.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# Must be a publicly reachable https URL Safaricom can POST the payment result to,
# e.g. https://api.yourdomain.com/api/payments/mpesa/callback. Use a tunnel
# (ngrok/localtunnel) for local testing — Safaricom cannot reach localhost.
MPESA_CALLBACK_URL=
