# Copy to .env and adjust. Vite only exposes vars prefixed with VITE_.
# Leave blank for the included Vite proxy, or set this to the public API origin
# when frontend and backend are deployed separately.
VITE_API_URL=

# Webhook URL for your self hosted n8n workflow that powers the marketplace page's
# AI Agent widget. It receives { message, sessionId, source } as JSON and should
# reply with JSON containing a text field (output, reply, text, or message all work).
# The widget still opens and explains itself if this is left blank.
VITE_N8N_WEBHOOK_URL=
