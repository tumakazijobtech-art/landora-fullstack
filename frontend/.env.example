# Copy to .env and adjust. Vite only exposes vars prefixed with VITE_.
# Leave blank for the included Vite proxy, or set this to the public API origin
# when frontend and backend are deployed separately.
VITE_API_URL=

# Live chat's realtime (Socket.io) origin. Leave blank to use the Vite dev proxy
# locally, or to fall back to VITE_API_URL with a trailing /api stripped off. Set
# explicitly when the frontend and backend are deployed to different origins, e.g.
# https://api.yourdomain.com (no trailing slash, no /api suffix).
VITE_SOCKET_URL=

# Webhook URL for your self hosted n8n workflow that powers the marketplace page's
# AI Agent widget. It receives { message, sessionId, source } as JSON and should
# reply with JSON containing a text field (output, reply, text, or message all work).
# The widget still opens and explains itself if this is left blank.
VITE_N8N_WEBHOOK_URL=

# Default brand assets (deploy-time fallback). An admin can override both from the
# Branding tab in /admin at runtime — that takes priority over these once saved.
# App icon should be an SVG (used as the browser tab icon). App logo should be square.
VITE_APP_ICON_URL=
VITE_APP_LOGO_URL=
